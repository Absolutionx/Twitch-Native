{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Twitch Native",
  "version": "2.0.1",
  "identifier": "com.twitchapp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Twitch Native",
        "width": 1100,
        "height": 700,
        "minWidth": 700,
        "minHeight": 450
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost https://id.twitch.tv https://api.twitch.tv https://gql.twitch.tv http://127.0.0.1:* https://7tv.io https://api.betterttv.net wss://irc-ws.chat.twitch.tv wss://eventsub.wss.twitch.tv wss://events.7tv.io https://usher.twitchapps.com https://*.cloudfront.net https://*.jtvnw.net https://*.twitchsvc.net; img-src 'self' data: https://static-cdn.jtvnw.net https://cdn.7tv.app https://*.7tv.app https://cdn.betterttv.net https:; media-src 'self' blob: http://127.0.0.1:*; script-src 'self'; style-src 'self' 'unsafe-inline'",
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "nsis/installer.nsi",
        "headerImage": "nsis/header.bmp",
        "sidebarImage": "nsis/sidebar.bmp",
        "installMode": "currentUser",
        "compression": "lzma"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Absolutionx/Twitch-Native/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2NkM0Qjk2RTUxOTFGOEIKUldTTEh4bmxsa3RzTm1LUmZYdlk0MGdBQitFdlM5YndxOGlCSm5ySnp3Yk5MT3V3UXlTMXE5YzcK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
